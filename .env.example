# ── Meta (Facebook + Instagram) integration ──
META_APP_ID=
META_APP_SECRET=
# Production callback — must EXACTLY match a "Valid OAuth Redirect URI" in the Meta app:
META_REDIRECT_URI=https://api.guildof1.com/api/v1/oauth/callback/meta
# For local development use instead:
# META_REDIRECT_URI=http://localhost:8001/api/v1/oauth/callback/meta

# ── Required for token encryption (Phase 1 makes the app refuse to boot with "changeme" in prod) ──
# Generate once with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
APP_ENV=local   # set to "production" in Cloud Run env vars
